{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Code Toolbox",
  "version": "0.3.2",
  "identifier": "io.github.dave-lv.code-toolbox",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run vsix && npm run dev",
    "beforeBuildCommand": "npm run vsix && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Code Toolbox",
        "width": 380,
        "height": 640,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/dev-layout.vsix": "dev-layout.vsix"
    },
    "publisher": "dave-lv",
    "shortDescription": "Tray app for VS Code projects and profiles",
    "category": "DeveloperTool",
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "linux": {
      "deb": {
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "depends": ["libayatana-appindicator-gtk3"]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
