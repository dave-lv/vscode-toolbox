  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.12",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
